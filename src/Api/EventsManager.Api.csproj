<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Document OpenAPI écrit sur disque à chaque build et versionné : artefact de déploiement
         et index structurel du zalando-reviewer (docs/api-conventions.md, section 7).
         Sans l option de nom de fichier, le document porterait le nom du projet. -->
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\..\docs</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Force la résolution transitive vers une version non vulnérable (NU1903 / GHSA-v5pm-xwqc-g5wc,
         corrigé en 2.7.5+). Microsoft.AspNetCore.OpenApi 10.0.9 tire sinon Microsoft.OpenApi 2.0.0. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\EventsManager.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\EventsManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
