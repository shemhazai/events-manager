<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- EF Core et Relational épinglés explicitement, et ce n'est pas redondant avec le
         provider : Npgsql 10.0.3 les déclare tous deux en [10.0.4, 11.0.0), donc NuGet
         résoudrait le minimum, 10.0.4, tandis que Microsoft.EntityFrameworkCore.Design reste
         épinglé en 10.0.9. Sans ces deux pins, l'Api et les tests compilent contre 10.0.9 (par
         cette référence de projet) et résolvent 10.0.4 à l'exécution — MSB3277, et ici un
         warning est une erreur. Les deux API sont de toute façon utilisées directement :
         DbContext et UseNpgsql côté EF Core, ToTable / HasComputedColumnSql /
         HasCheckConstraint / MigrationBuilder côté Relational. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time uniquement (dotnet ef migrations/database) : ne doit pas fuiter aux consommateurs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\EventsManager.Application.csproj" />
  </ItemGroup>

</Project>
