<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Force la résolution transitive de System.Security.Cryptography.Pkcs vers une version non
         vulnérable (NU1903 / GHSA-846f-f764-76mx et NU1902 / GHSA-2fmv-rv2c-59x7). Chaîne fautive :
         EF Core SqlServer 10.0.9 tire Microsoft.Data.SqlClient 6.1.1, qui tire Pkcs 9.0.4.
         Monter EF ne règle rien : la 10.0.13 tire SqlClient 6.1.7, qui tire Pkcs 9.0.11, vulnérable
         aussi (mesuré le 2026-10-15). Le pin vit dans ce projet parce que c'est lui qui tire EF
         SqlServer ; l'Api et les tests en héritent par référence de projet.
         Condition de retrait : la migration PostgreSQL, qui supprime la chaîne entière. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- Design-time uniquement (dotnet ef migrations/database) : ne doit pas fuiter aux consommateurs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\EventsManager.Application.csproj" />
  </ItemGroup>

</Project>
